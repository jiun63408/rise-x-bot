# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요. .env 는 절대 남에게 보내지 마세요.

# yes 로 바꿔야만 실제 주문이 나갑니다. 그 외에는 모의 모드.
LIVE_TRADING=no

# 실전 모드에서만 필요. 봇 전용 새 지갑의 개인키를 쓰세요 (메인 지갑 X).
RISEX_PRIVATE_KEY=

SYMBOL=BTC
ORDER_SIZE=0.00015
DROP_WINDOW_SEC=60
DROP_PCT=1.0
STOP_LOSS_PCT=1.0
TAKE_PROFIT_PCT=2.0
COOLDOWN_SEC=300
MAX_TRADES_PER_DAY=5
MAX_ORDER_USD=30
POLL_SEC=2
MAX_CONSECUTIVE_ERRORS=10
MAX_CLOSE_FAILURES=3

# 서명키가 RISEx 에 미등록이면 자동 등록할지 (메인넷에 서명을 보냄). 기본 no.
AUTO_REGISTER_SIGNER=no
